# ---- Face-Off environment ----
# Copy to .env.local and fill in real values. Never commit .env.local.

# Google Cloud OAuth 2.0 credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Public base URL of the app. In dev, point this at the Vite dev server so the
# OAuth callback round-trips through the /api proxy:
#   http://localhost:5173  (vite dev server, /api proxied to the Fastify server)
#   http://localhost:3001  (server-only, prod-style)
BASE_URL=http://localhost:5173

# Random secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me

# OAuth scope (read-only only).
OAUTH_SCOPE=https://www.googleapis.com/auth/youtube.readonly

# Server port
PORT=3001

# Client data source. Defaults to mock subscriptions (no credentials needed).
# Set to false to use the real OAuth + YouTube Data API flow.
VITE_USE_MOCK=false

# ---- End-to-end test-only settings (see docs/ + playwright/) ----
# Only read when the app is started with these values; harmless otherwise.
# E2E_MOCK=true activates /e2e/* routes that stand in for Google + YouTube.
# E2E_TOKEN_ENDPOINT and E2E_SUBSCRIPTIONS_ENDPOINT redirect the real OAuth and
# YouTube calls to those mock routes when set.
# E2E_MOCK=true
# E2E_TOKEN_ENDPOINT=http://127.0.0.1:3001/e2e/oauth/token
# E2E_SUBSCRIPTIONS_ENDPOINT=http://127.0.0.1:3001/e2e/yt/subscriptions